# Copy to .env.test (ignored by git) and fill in.
# Used only by the integration tests: cd src-tauri && cargo test -- --ignored --test-threads=1
# Prefer a test user; the tests only create a TEMP table in PostgreSQL
# and only run SELECT / anonymous PL/SQL in Oracle. MySQL and SQL Server
# tests use temporary tables plus a few lq_* tables they drop at the end.

LQ_PG_HOST=
LQ_PG_PORT=5432
LQ_PG_USER=
LQ_PG_PASSWORD=
LQ_PG_DB=postgres

LQ_ORA_HOST=
LQ_ORA_PORT=1521
LQ_ORA_SERVICE=
LQ_ORA_USER=
LQ_ORA_PASSWORD=

LQ_MYSQL_HOST=
LQ_MYSQL_PORT=3306
LQ_MYSQL_USER=root
LQ_MYSQL_PASSWORD=
LQ_MYSQL_DB=lowquery
# mysql or mariadb
LQ_MYSQL_ENGINE=mysql

LQ_MSSQL_HOST=
LQ_MSSQL_PORT=1433
LQ_MSSQL_USER=sa
LQ_MSSQL_PASSWORD=
LQ_MSSQL_DB=master

LQ_REDIS_HOST=
LQ_REDIS_PORT=6379
LQ_REDIS_PASSWORD=
