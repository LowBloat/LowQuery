{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LowQuery",
  "version": "0.5.4",
  "identifier": "dev.lowbloat.lowquery",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LowQuery",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "maximized": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LowBloat",
    "category": "DeveloperTool",
    "shortDescription": "Lightweight SQL client for Oracle and PostgreSQL",
    "longDescription": "LowQuery is a lightweight SQL client for people who work with multiple databases, with a native driver for each one.",
    "copyright": "Copyright © 2026 LowBloat. Licensed under AGPL-3.0-only.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LowBloat/LowQuery/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzQjQyRUZERDRFNDI2QUIKUldTckp1VFUvUzYwdzYwaVpFS1dtRjhzeFZxbkt4VEpjMUorbEN2emk1MjdHektJczlTcXl4SkYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
